# IceTrack — Environment Variables
# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase project under Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# IceTrack Assistant (RAG + Groq). Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional override (default: llama-3.1-8b-instant)
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
